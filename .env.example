# No API key is required to run this app. Geocoding (Nominatim) and driving
# distance/duration (OSRM) both default to free public servers.
#
# Everything below is OPTIONAL — only set these if you want to point at a
# self-hosted instance (recommended for anything beyond light personal use;
# see README.md) or need to identify your app to Nominatim's usage policy.

# Nominatim (geocoding). Defaults to https://nominatim.openstreetmap.org
NOMINATIM_BASE_URL=
# Required by Nominatim's usage policy if you use the public server: an
# identifying User-Agent naming your app + contact info, e.g.
# "pickup-route-planner (you@example.com)".
NOMINATIM_USER_AGENT=

# OSRM (driving distance/duration + route geometry). Defaults to the public
# demo server https://router.project-osrm.org
OSRM_BASE_URL=
