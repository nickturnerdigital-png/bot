# --- Server-side key (required) ---
# Used only in API routes (never sent to the browser).
# Needs: Geocoding API, Routes API (or Distance Matrix API) enabled, billing enabled on the project.
GOOGLE_MAPS_SERVER_KEY=

# --- Browser key (optional, only needed for the visual map view) ---
# Used client-side to render the Maps JavaScript API map. Restrict this key by
# HTTP referrer (your domain) in Google Cloud Console — never reuse the server key here.
# Needs: Maps JavaScript API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
